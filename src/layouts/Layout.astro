---
interface Props {
  title: string;
  /** meta description 与 OG 描述；缺省用站点描述 */
  description?: string;
  /** OG 类型：文章页传 article，其余 website */
  ogType?: "website" | "article";
  /** 是否显示顶部阅读进度条（文章页用） */
  progress?: boolean;
  /** 是否禁止收录（404 等页面用） */
  noindex?: boolean;
  /** 首页等页面可加宽显示区域 */
  wide?: boolean;
  /** 文章页：更宽的正文区 */
  articleWide?: boolean;
  /** 是否用整张毛玻璃面板包裹内容（首页用独立卡片时关掉） */
  panel?: boolean;
  /** 是否启用背景漂移光斑（仅首屏类页面开启） */
  drift?: boolean;
}
const {
  title,
  description = siteConfig.description,
  ogType = "website",
  progress = false,
  noindex = false,
  wide,
  articleWide,
  panel = true,
  drift = false,
} = Astro.props;
const year = new Date().getFullYear();
const hasHero = Astro.slots.has("hero");
const pathname = Astro.url.pathname;
const isHome = pathname === "/" || /^\/page\/\d+\/?$/.test(pathname);
import { ClientRouter } from "astro:transitions";
import { siteConfig } from "../config";

// 分享卡片与 canonical 需要绝对 URL：astro.config 里的 site 优先，缺失时退回当前地址
const base = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, base);
// 分享图暂用首屏背景图（自动生成标题卡片图是后续轮次的事）
const ogImage = new URL("/images/bg.jpg", base);
const pageTitle =
  title === siteConfig.siteName ? title : `${title} · ${siteConfig.siteName}`;
---

<!doctype html>
<html lang="zh-CN" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.name} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafafa" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#111114" />

    <!-- 分享卡片（微信 / Telegram / X 等读取 OG） -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteConfig.siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1920" />
    <meta property="og:image:height" content="1280" />
    <meta property="og:image:alt" content={siteConfig.siteName} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- 文章页可往这里补 og:article:* 等页面专属标签 -->
    <slot name="head" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteConfig.siteName}
      href="/rss.xml"
    />
    <ClientRouter />
    <!-- 主题初始化：在任何内容渲染前应用，防止刷新闪烁 (FOUC) -->
    <script is:inline>
      (function () {
        function applyStoredTheme() {
          try {
            var t = localStorage.getItem("theme");
            if (t === "light" || t === "dark") {
              document.documentElement.dataset.theme = t;
            }
          } catch (e) {}
        }
        applyStoredTheme();
        document.addEventListener("astro:after-swap", applyStoredTheme);
      })();
    </script>
  </head>
  <body>
    {
      progress && (
        <div class="read-progress" aria-hidden="true">
          <span class="read-progress-fill" />
        </div>
      )
    }
    <slot name="hero" />
    <div class:list={["page-shell", { "has-hero": hasHero }]}>
      <main
        class:list={["container", { "container-wide": wide, "container-article": articleWide }]}
      >
        {panel ? <div class="glass-panel"><slot /></div> : <slot />}
      </main>
      <div class="side-rail">
        <header class="site-header">
          <hgroup class="brand-group">
            <a href="/" class="logo">{siteConfig.siteName}</a>
            {siteConfig.tagline && <p class="brand-sub">{siteConfig.tagline}</p>}
          </hgroup>
          <nav class="site-nav" aria-label="主导航">
            <ul class="nav-links">
              <li><a href="/" class={isHome ? "active" : ""}>首页</a></li>
              <li><a href="/archive/" class={pathname.startsWith("/archive") ? "active" : ""}>归档</a></li>
              <li>
                <a href="https://github.com/FSJGDJ" target="_blank" rel="noopener">GitHub</a>
              </li>
            </ul>
            <div class="nav-actions">
              <a href="/rss.xml" target="_blank" rel="noopener" aria-label="RSS" title="RSS">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 11a9 9 0 0 1 9 9"></path>
                  <path d="M4 4a16 16 0 0 1 16 16"></path>
                  <circle cx="5" cy="19" r="1"></circle>
                </svg>
              </a>
              {siteConfig.email && (
                <a href={`mailto:${siteConfig.email}`} aria-label="邮箱" title="邮箱">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                    <path d="m22 7-10 6L2 7"></path>
                  </svg>
                </a>
              )}
              <button class="theme-toggle" type="button" aria-label="切换明暗模式">
                <svg
                  class="icon-sun"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="12" r="4"></circle>
                  <path
                    d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
                  ></path>
                </svg>
                <svg
                  class="icon-moon"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                </svg>
              </button>
            </div>
          </nav>
        </header>
        <footer class="site-footer">
          <p>© {year} <a href="/">{siteConfig.siteName}</a></p>
          <p>
            Powered by <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>
          </p>
        </footer>
        <div class="ruler-track" aria-hidden="true">
          <div class="ruler-vernier">
            <span class="ruler-pct">0%</span>
            <span class="ruler-tri"></span>
          </div>
        </div>
      </div>
    </div>
    <!-- glass-panel 的 backdrop-filter 会劫持后代 fixed 定位，
         需要真正相对视口悬浮的元素（如文章目录）从这里渲染 -->
    <slot name="toc" />

    <!-- 全站交互初始化：复刻 tsglz 顺序淡出/淡入切换 + ClientRouter 生命周期适配 -->
    <script>
      (function () {
        const LEAVE_MS = 500;
        const reducedMotion = () =>
          window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        // 1. 离开当前页：先让旧 <main> 向下 1rem 淡出，与网络请求并行等待
        document.addEventListener("astro:before-preparation", (ev) => {
          const e = ev as Event & {
            from: URL;
            to: URL;
            signal: AbortSignal;
            loader: () => Promise<void>;
          };
          if (e.from.pathname === e.to.pathname && e.from.search === e.to.search) {
            return;
          }
          if (reducedMotion()) return;

          const originalLoader = e.loader;
          e.loader = async () => {
            document.documentElement.classList.add("is-leaving");
            const waitLeave = new Promise<void>((resolve) => {
              const timer = window.setTimeout(resolve, LEAVE_MS);
              e.signal?.addEventListener(
                "abort",
                () => {
                  window.clearTimeout(timer);
                  document.documentElement.classList.remove("is-leaving");
                  resolve();
                },
                { once: true },
              );
            });
            await Promise.all([originalLoader(), waitLeave]);
          };
        });

        // 2. 替换 DOM 前：同步暗色主题，并把新页面预置为“上方 -1rem 透明”入场态
        document.addEventListener("astro:before-swap", (ev) => {
          const e = ev as Event & { newDocument: Document };
          try {
            const t = localStorage.getItem("theme");
            if (t === "light" || t === "dark") {
              e.newDocument.documentElement.dataset.theme = t;
            }
          } catch {}
          if (!reducedMotion()) {
            e.newDocument.documentElement.classList.add("is-entering");
          }
        });

        // 3. 替换 DOM 后：移除 leaving，并在下一帧释放 entering 触发平滑下滑淡入
        document.addEventListener("astro:after-swap", () => {
          document.documentElement.classList.remove("is-leaving");
          if (document.documentElement.classList.contains("is-entering")) {
            requestAnimationFrame(() => {
              requestAnimationFrame(() => {
                document.documentElement.classList.remove("is-entering");
              });
            });
          }
        });

        let pageAbort: AbortController | null = null;

        function initPage() {
          pageAbort?.abort();
          pageAbort = new AbortController();
          const { signal } = pageAbort;

          // 1. 明暗切换
          const btn = document.querySelector<HTMLButtonElement>(".theme-toggle");
          if (btn) {
            const mq = window.matchMedia("(prefers-color-scheme: dark)");
            const resolved = () => {
              const t = document.documentElement.dataset.theme;
              if (t === "light" || t === "dark") return t;
              return mq.matches ? "dark" : "light";
            };
            const updateIcon = () => {
              const dark = resolved() === "dark";
              btn.querySelector(".icon-sun")?.toggleAttribute("hidden", !dark);
              btn.querySelector(".icon-moon")?.toggleAttribute("hidden", dark);
              btn.setAttribute(
                "aria-label",
                dark ? "切换到亮色模式" : "切换到暗色模式",
              );
            };
            btn.addEventListener(
              "click",
              () => {
                const next = resolved() === "dark" ? "light" : "dark";
                document.documentElement.dataset.theme = next;
                try {
                  localStorage.setItem("theme", next);
                } catch (e) {}
                updateIcon();
              },
              { signal },
            );
            mq.addEventListener(
              "change",
              () => {
                if (!document.documentElement.dataset.theme) updateIcon();
              },
              { signal },
            );
            updateIcon();
          }

          // 2. 首页首屏滚动显隐左侧栏
          const shell = document.querySelector(".page-shell.has-hero");
          const rail = shell?.querySelector(".side-rail");
          if (shell && rail) {
            const io = new IntersectionObserver(
              (entries) => {
                for (const entry of entries) {
                  rail.classList.toggle("rail-visible", entry.isIntersecting);
                }
              },
              { threshold: 0.05 },
            );
            io.observe(shell);
            signal.addEventListener("abort", () => io.disconnect());
          }

          // 3. 工程标尺游标 + 顶部阅读进度条（共用 rAF 节流）
          const track = document.querySelector<HTMLElement>(".ruler-track");
          const vernier = document.querySelector<HTMLElement>(".ruler-vernier");
          const pctEl = document.querySelector<HTMLElement>(".ruler-pct");
          const fill = document.querySelector<HTMLElement>(".read-progress-fill");

          if ((track && vernier && pctEl) || fill) {
            let ticking = false;
            const updateScrollUI = () => {
              const doc = document.documentElement;
              const max = doc.scrollHeight - window.innerHeight;
              const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
              if (track && vernier && pctEl) {
                const travel = Math.max(0, track.clientHeight - vernier.offsetHeight);
                vernier.style.transform = `translateY(${(p * travel).toFixed(1)}px)`;
                pctEl.textContent = `${Math.round(p * 100)}%`;
              }
              if (fill) {
                fill.style.transform = `scaleX(${p})`;
              }
              ticking = false;
            };
            window.addEventListener(
              "scroll",
              () => {
                if (ticking) return;
                ticking = true;
                requestAnimationFrame(updateScrollUI);
              },
              { passive: true, signal },
            );
            window.addEventListener("resize", updateScrollUI, { signal });
            updateScrollUI();
          }
        }

        document.addEventListener("astro:page-load", initPage);
        document.addEventListener("astro:before-swap", () => {
          pageAbort?.abort();
          pageAbort = null;
        });
      })();
    </script>
  </body>
</html>

<style>
  :root,
  [data-theme="light"] {
    --bg: #ffffff;
    --card: rgba(255, 255, 255, 0.88);
    --text: #1c1917;
    --muted: #6b7280;
    --accent: #1c1917;
    --border: rgba(28, 25, 23, 0.12);
    --grid-line: rgba(28, 25, 23, 0.045);
    --code-bg: #111318;
    --code-text: #e6edf3;
    --dur-fast: 0.15s;
    --dur-base: 0.25s;
    --dur-slow: 0.3s;
    --ease: cubic-bezier(0.4, 0, 0.2, 1);
    --font-mono:
      "JetBrains Mono", "Cascadia Code", Consolas, "SFMono-Regular",
      Menlo, monospace;
    --font-serif:
      "Source Han Serif SC", "Noto Serif SC", "Songti SC", "STSong",
      "SimSun", serif;
    --font-ui:
      "Source Sans Pro", "Roboto", "Helvetica", "Helvetica Neue",
      "Source Han Sans SC", "Source Han Sans TC", "PingFang SC",
      "Microsoft YaHei", sans-serif;
  }

  /* 系统暗色模式自动切换（未手动选择时生效） */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #171717;
      --card: rgba(28, 28, 28, 0.88);
      --text: #e7e5e4;
      --muted: #a3a3a3;
      --accent: #e7e5e4;
      --border: rgba(255, 255, 255, 0.12);
      --grid-line: rgba(255, 255, 255, 0.045);
      --code-bg: #0d1117;
      --code-text: #e6edf3;
    }
  }

  [data-theme="dark"] {
    --bg: #171717;
    --card: rgba(28, 28, 28, 0.88);
    --text: #e7e5e4;
    --muted: #a3a3a3;
    --accent: #e7e5e4;
    --border: rgba(255, 255, 255, 0.12);
    --grid-line: rgba(255, 255, 255, 0.045);
    --code-bg: #0d1117;
    --code-text: #e6edf3;
  }

  * {
    box-sizing: border-box;
  }

  :global(html) {
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, var(--muted) 45%, transparent) transparent;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    scroll-behavior: smooth;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
  }
  :global(::-webkit-scrollbar) {
    width: 8px;
    height: 8px;
  }
  :global(::-webkit-scrollbar-track) {
    background: transparent;
  }
  :global(::-webkit-scrollbar-thumb) {
    background: color-mix(in srgb, var(--muted) 35%, transparent);
    border: 2px solid transparent;
    background-clip: content-box;
    border-radius: 999px;
  }
  :global(::-webkit-scrollbar-thumb:hover) {
    background: color-mix(in srgb, var(--text) 55%, transparent);
    background-clip: content-box;
  }

  :global(::selection) {
    background: var(--text);
    color: var(--bg);
  }

  /* 禁用浏览器默认的视图快照交叉叠影，改由下方顺序过渡（仿 tsglz / Swup）完全接管 */
  :global(::view-transition-old(root)),
  :global(::view-transition-new(root)) {
    animation: none;
  }

  /* 与 tsglz.vercel.app 一致的顺序切换效果：
     先旧内容向下 1rem 淡出，再新内容从上方 -1rem 平滑落位淡入；左侧栏全程稳固不动 */
  main.container {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 0.5s linear,
      transform 0.5s linear;
  }
  :global(html.is-leaving) main.container {
    opacity: 0;
    transform: translateY(1rem);
  }
  :global(html.is-entering) main.container {
    opacity: 0;
    transform: translateY(-1rem);
    transition: none;
  }
  @media (prefers-reduced-motion: reduce) {
    main.container {
      transition: none;
    }
    :global(html.is-leaving) main.container,
    :global(html.is-entering) main.container {
      opacity: 1;
      transform: none;
    }
  }

  /* 全局纸张方格底纹（7px × 7px） */
  body {
    margin: 0;
    background-color: var(--bg);
    background-size: 7px 7px;
    background-image:
      linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
    color: var(--text);
    font-family: var(--font-ui);
    text-shadow: 1px 1px 1px var(--grid-line);
    line-height: 1.8;
    min-height: 100vh;
  }

  /* 阅读进度条 */
  .read-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 20;
    background: color-mix(in srgb, var(--text) 10%, transparent);
    pointer-events: none;
  }
  .read-progress-fill {
    display: block;
    height: 100%;
    background: var(--text);
    transform: scaleX(0);
    transform-origin: left center;
    will-change: transform;
  }

  :global(h1),
  :global(h2),
  :global(h3) {
    font-family: var(--font-serif);
    font-weight: 600;
    line-height: 1.4;
  }

  /* 移动端默认单栏：导航在顶部，正文居中，页脚在底部 */
  .page-shell {
    max-width: 1350px;
    margin: 0 auto;
    padding: 1.5rem 1.25rem 2.5rem;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .side-rail {
    display: contents;
  }

  .site-header {
    order: -1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.1rem;
    margin-bottom: 2.2rem;
  }

  .brand-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
  }

  .logo {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.5rem;
    color: var(--text);
    text-decoration: none;
    padding: 0.15rem 0.45rem;
    transition:
      background-color var(--dur-slow) var(--ease),
      color var(--dur-slow) var(--ease);
  }
  .logo:hover {
    background-color: var(--text);
    color: var(--bg);
  }

  .brand-sub {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.5;
  }

  .site-nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
  }

  .nav-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.9rem 1.2rem;
  }

  .nav-links a,
  .site-footer a {
    color: var(--text);
    padding: 2px 3px;
    text-decoration: underline;
    text-decoration-thickness: 0.1em;
    text-underline-offset: 3px;
    transition:
      background-color var(--dur-slow) var(--ease),
      color var(--dur-slow) var(--ease);
  }
  .nav-links a:hover,
  .nav-links a.active,
  .site-footer a:hover {
    background-color: var(--text);
    color: var(--bg);
    text-decoration-color: var(--text);
  }
  .nav-links a.active {
    font-weight: 600;
  }

  .ruler-track {
    display: none;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .nav-actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    color: var(--muted);
    text-decoration: none;
    border-radius: 4px;
    transition:
      color var(--dur-base) var(--ease),
      background-color var(--dur-base) var(--ease);
  }
  .nav-actions a:hover {
    color: var(--bg);
    background-color: var(--text);
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition:
      color var(--dur-base) var(--ease),
      border-color var(--dur-base) var(--ease),
      background-color var(--dur-base) var(--ease);
  }
  .theme-toggle:hover {
    color: var(--bg);
    background-color: var(--text);
    border-color: var(--text);
  }
  .theme-toggle svg[hidden] {
    display: none;
  }

  main.container {
    width: 100%;
    flex: 1;
    min-width: 0;
  }

  .glass-panel {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.6rem 1.4rem;
  }

  .site-footer {
    margin-top: 3rem;
    padding: 1.5rem 0 0.5rem;
    text-align: center;
    color: var(--muted);
