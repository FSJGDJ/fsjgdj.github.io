---
interface Props {
  title: string;
  /** meta description 与 OG 描述；缺省用站点描述 */
  description?: string;
  /** OG 类型：文章页传 article，其余 website */
  ogType?: "website" | "article";
  /** 是否显示顶部阅读进度条（文章页用） */
  progress?: boolean;
  /** 是否禁止收录（404 等页面用） */
  noindex?: boolean;
  /** 首页等页面可加宽显示区域 */
  wide?: boolean;
  /** 文章页：更宽的正文区 */
  articleWide?: boolean;
  /** 是否用整张毛玻璃面板包裹内容（首页用独立卡片时关掉） */
  panel?: boolean;
  /** 是否启用背景漂移光斑（仅首屏类页面开启） */
  drift?: boolean;
}
const {
  title,
  description = siteConfig.description,
  ogType = "website",
  progress = false,
  noindex = false,
  wide,
  articleWide,
  panel = true,
  drift = false,
} = Astro.props;
const year = new Date().getFullYear();
import { siteConfig } from "../config";

// 分享卡片与 canonical 需要绝对 URL：astro.config 里的 site 优先，缺失时退回当前地址
const base = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, base);
// 分享图暂用首屏背景图（自动生成标题卡片图是后续轮次的事）
const ogImage = new URL("/images/bg.jpg", base);
const pageTitle =
  title === siteConfig.siteName ? title : `${title} · ${siteConfig.siteName}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.name} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafafa" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#111114" />

    <!-- 分享卡片（微信 / Telegram / X 等读取 OG） -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteConfig.siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1920" />
    <meta property="og:image:height" content="1280" />
    <meta property="og:image:alt" content={siteConfig.siteName} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- 文章页可往这里补 og:article:* 等页面专属标签 -->
    <slot name="head" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteConfig.siteName}
      href="/rss.xml"
    />
    <!-- 霞鹜文楷 Lite：97 个 unicode-range 分片，浏览器只下载本页用到的几片 -->
    <link rel="stylesheet" href="/fonts/lxgw/lxgw.css" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/lxgw/lxgwwenkailite-regular-subset-118.woff2"
      crossorigin
    />
    <!-- 主题初始化：在任何内容渲染前应用，防止刷新闪烁 (FOUC) -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (t === "light" || t === "dark") {
            document.documentElement.dataset.theme = t;
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    {
      progress && (
        <div class="read-progress" aria-hidden="true">
          <span class="read-progress-fill" />
        </div>
      )
    }
    {
      drift && (
        <div class="bg-drift" aria-hidden="true">
          <span class="blob b1" />
          <span class="blob b2" />
          <span class="blob b3" />
        </div>
      )
    }
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="logo">{siteConfig.siteName}</a>
        <nav>
          <a href="/">首页</a>
          <a href="/archive/">归档</a>
          <a href="https://github.com/FSJGDJ" target="_blank" rel="noopener"
            >GitHub</a
          >
          <button class="theme-toggle" type="button" aria-label="切换明暗模式">
            <svg
              class="icon-sun"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path
                d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
              ></path>
            </svg>
            <svg
              class="icon-moon"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>
    <main class:list={["container", { "container-wide": wide, "container-article": articleWide }]}>
      {panel ? <div class="glass-panel"><slot /></div> : <slot />}
    </main>
    <!-- glass-panel 的 backdrop-filter 会劫持后代 fixed 定位，
         需要真正相对视口悬浮的元素（如文章目录）从这里渲染 -->
    <slot name="toc" />
    <footer class="site-footer">
      <p>
        © {year} {siteConfig.siteName} · <a href="https://github.com/FSJGDJ" target="_blank"
          rel="noopener">GitHub</a
        > · <a href="/rss.xml">RSS</a>
        {siteConfig.email && (
          <>
            {" "}· <a href={`mailto:${siteConfig.email}`}>邮箱</a>
          </>
        )}
        · Powered by <a
          href="https://astro.build"
          target="_blank"
          rel="noopener">Astro</a
        >
      </p>
    </footer>

    <!-- 明暗切换：data-theme 优先，其次跟随系统 -->
    <script>
      (function () {
        const btn = document.querySelector(".theme-toggle");
        if (!btn) return;
        const mq = window.matchMedia("(prefers-color-scheme: dark)");

        function resolved() {
          const t = document.documentElement.dataset.theme;
          if (t === "light" || t === "dark") return t;
          return mq.matches ? "dark" : "light";
        }

        function updateIcon() {
          const dark = resolved() === "dark";
          btn.querySelector(".icon-sun").toggleAttribute("hidden", !dark);
          btn.querySelector(".icon-moon").toggleAttribute("hidden", dark);
          btn.setAttribute(
            "aria-label",
            dark ? "切换到亮色模式" : "切换到暗色模式",
          );
        }

        btn.addEventListener("click", () => {
          const next = resolved() === "dark" ? "light" : "dark";
          document.documentElement.dataset.theme = next;
          try {
            localStorage.setItem("theme", next);
          } catch (e) {}
          updateIcon();
        });

        mq.addEventListener("change", () => {
          // 用户未手动选择时，跟随系统变化
          if (!document.documentElement.dataset.theme) updateIcon();
        });

        updateIcon();
      })();
    </script>

    <!-- 阅读进度条：顶部 2px 细线按全文滚动比例填充。
         放在 glass-panel 之外——面板的 backdrop-filter 会劫持后代 fixed 定位 -->
    {
      progress && (
        <script>
          (function () {
            const fill = document.querySelector<HTMLElement>(".read-progress-fill");
            if (!fill) return;
            let ticking = false;
            function update() {
              const doc = document.documentElement;
              const max = doc.scrollHeight - window.innerHeight;
              const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
              fill.style.transform = `scaleX(${p})`;
              ticking = false;
            }
            window.addEventListener(
              "scroll",
              () => {
                if (ticking) return;
                ticking = true;
                requestAnimationFrame(update);
              },
              { passive: true },
            );
            window.addEventListener("resize", update);
            update();
          })();
        </script>
      )
    }
  </body>
</html>

<style>
  :root,
  [data-theme="light"] {
    --bg: #fafafa;
    --card: rgba(255, 255, 255, 0.72);
    --text: #1f2328;
    --muted: #5b6470;
    --accent: #4f46e5;
    --border: rgba(229, 231, 235, 0.9);
    --code-bg: #0d1117;
    --code-text: #e6edf3;
    /* 背景图上的可读性遮罩（与背景图层合并，见 body::before） */
    --scrim: rgba(250, 250, 250, 0.45);
    /* 动效节奏变量：全站悬停/状态过渡只用这三档，避免各处手写时长打架 */
    --dur-fast: 0.15s;
    --dur-base: 0.2s;
    --dur-slow: 0.3s;
    --ease: cubic-bezier(0.4, 0, 0.2, 1);
    --font-sans:
      system-ui, -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
    --font-mono:
      "JetBrains Mono", "Cascadia Code", Consolas, "SFMono-Regular",
      Menlo, monospace;
    /* 标题字体：霞鹜文楷 Lite（自托管分包，public/fonts/lxgw）
       后面几个是兜底——字体没加载完时先落系统衬线，不会出现无衬线的空档 */
    --font-serif:
      "LXGW WenKai Lite", "Source Han Serif SC", "Noto Serif SC", "Songti SC",
      "STSong", "SimSun", serif;
  }

  /* 系统暗色模式自动切换（未手动选择时生效） */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #111114;
      --card: rgba(23, 26, 33, 0.74);
      --text: #e6e8ee;
      --muted: #a8b3bd;
      --accent: #a5b4fc;
      --border: rgba(42, 47, 58, 0.9);
      --code-bg: #0d1117;
      --code-text: #e6edf3;
      --scrim: rgba(17, 17, 20, 0.55);
    }
  }

  [data-theme="dark"] {
    --bg: #111114;
    --card: rgba(23, 26, 33, 0.74);
    --text: #e6e8ee;
    --muted: #a8b3bd;
    --accent: #a5b4fc;
    --border: rgba(42, 47, 58, 0.9);
    --code-bg: #0d1117;
    --code-text: #e6edf3;
    --scrim: rgba(17, 17, 20, 0.55);
  }

  * {
    box-sizing: border-box;
  }

  /* 细圆角滚动条：Windows 默认宽滚动条会把毛玻璃质感毁掉。
     标准属性给 Firefox / 新版 Chromium，::-webkit-* 给旧版 Chromium 与 Safari。
     两者同时存在时浏览器优先采用标准属性，不会打架 */
  :global(html) {
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, var(--muted) 45%, transparent) transparent;
  }
  :global(::-webkit-scrollbar) {
    width: 10px;
    height: 10px;
  }
  :global(::-webkit-scrollbar-track) {
    background: transparent;
  }
  :global(::-webkit-scrollbar-thumb) {
    background: color-mix(in srgb, var(--muted) 38%, transparent);
    /* 三像素透明边框配合 content-box，让滑块变成细胶囊 */
    border: 3px solid transparent;
    background-clip: content-box;
    border-radius: 999px;
  }
  :global(::-webkit-scrollbar-thumb:hover) {
    background: color-mix(in srgb, var(--accent) 60%, transparent);
    background-clip: content-box;
  }

  /* 选中文字用主题色半透明底，默认的蓝块在暖色背景上很跳 */
  :global(::selection) {
    background: color-mix(in srgb, var(--accent) 22%, transparent);
    color: var(--text);
  }

  html {
    scroll-behavior: smooth;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  /* 全屏固定背景图：云海山峦 + 可读性遮罩。
     遮罩从独立伪元素合并进背景层（同一个 linear-gradient 叠在图片上），
     这样 z-index:-1 这一层就空出来给漂移光斑——否则光斑会被遮罩盖住，完全看不见。
     视觉上等价：两层原本都是 inset:0 的 fixed 全屏覆盖。 */
  body::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -2;
    background-image:
      linear-gradient(var(--scrim), var(--scrim)),
      url("/images/bg.jpg");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  /* 遮罩色随主题切换：亮色蒙白纱、暗色蒙深纱 */

  /* 背景漂移光斑：
     叠在背景图+遮罩(-2)之上、内容之下(-1)，只动 transform 走合成层。
     编排要点：①负延迟让三个光斑加载即处于不同相位，不会一起起步；
     ②时长 7/10/13s 两两互质，合成周期极长，肉眼找不到循环点；
     ③alternate 往返，首尾无缝无跳变。 */
  .bg-drift {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }
  .bg-drift .blob {
    position: absolute;
    display: block;
    border-radius: 50%;
    background: radial-gradient(
      circle at center,
      color-mix(in srgb, var(--accent) 30%, transparent) 0%,
      transparent 68%
    );
    filter: blur(28px);
    will-change: transform;
    animation: drift-x var(--drift-dur) cubic-bezier(0.5, 0.5, 0.45, 0.5)
      infinite alternate;
    animation-delay: var(--drift-delay);
  }
  .bg-drift .b1 {
    --drift-dur: 7s;
    --drift-delay: -2s;
    width: 46vw;
    height: 46vw;
    top: -12vw;
    left: -8vw;
    opacity: 0.5;
  }
  .bg-drift .b2 {
    --drift-dur: 10s;
    --drift-delay: -3s;
    width: 38vw;
    height: 38vw;
    top: 8vh;
    right: -10vw;
    opacity: 0.38;
  }
  .bg-drift .b3 {
    --drift-dur: 13s;
    --drift-delay: -4s;
    width: 42vw;
    height: 42vw;
    bottom: -14vw;
    left: 24vw;
    opacity: 0.3;
  }
  @keyframes drift-x {
    from {
      transform: translate3d(-70px, -22px, 0);
    }
    to {
      transform: translate3d(70px, 22px, 0);
    }
  }
  /* 暗色主题下光斑亮度更高，透明度压低避免抢戏 */
  :global(html[data-theme="dark"]) .bg-drift .blob {
    opacity: 0.22;
  }
  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme="light"])) .bg-drift .blob {
      opacity: 0.22;
    }
  }
  /* 减弱动态效果：装饰性漂移完全停掉。
     必须放在漂移规则之后——同优先级下靠源码顺序决胜，放前面会被覆盖 */
  @media (prefers-reduced-motion: reduce) {
    .bg-drift .blob {
      animation: none;
      will-change: auto;
    }
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-sans);
    line-height: 1.8;
    /* 中英文/数字与汉字之间自动加空隙（"用 ffmpeg 和 Node.js" 这类混排会明显精致）。
       渐进增强：目前 Firefox / Safari 已支持，Chromium 尚未实现，不支持的老浏览器直接忽略 */
    text-autospace: normal;
    display: flex;
    min-height: 100vh;
    flex-direction: column;
  }

  /* 阅读进度条：只有 transform 在动，走合成层，不触发布局 */
  .read-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    /* 压在 sticky 头部（z-index 10）之上 */
    z-index: 20;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    pointer-events: none;
  }
  .read-progress-fill {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left center;
    will-change: transform;
  }

  /* 标题统一用标题字体（霞鹜文楷），正文保持无衬线，形成中西文混排的杂志感。
     字重用 500：自托管只装了 Regular 一个字重，500 会直接落到 400，
     不会像 600 那样被浏览器合成 faux-bold 把楷体笔画糊粗。
     必须 :global——markdown 渲染出的标题不带本组件的 scoped 属性，
     否则会回退成 body 同款无衬线，看上去“小标题像正文一样没有正常显示” */
  :global(h1),
  :global(h2),
  :global(h3) {
    font-family: var(--font-serif);
    font-weight: 500;
    line-height: 1.4;
  }

  .container {
    width: min(680px, 92%);
    margin: 0 auto;
  }
  /* 首页等需要加宽的页面：宽到能容纳 左列表 + 右统计 的分栏 */
  .container-wide {
    width: min(1120px, 96%);
  }
  /* 文章页：更宽的正文区 */
  .container-article {
    width: min(860px, 94%);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    background: color-mix(in srgb, var(--card) 82%, transparent);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.9rem 1.5rem;
  }

  .logo {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--text);
    text-decoration: none;
  }

  nav {
    display: flex;
    align-items: center;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
    margin-left: 1.2rem;
    font-size: 0.95rem;
    transition: color var(--dur-base) var(--ease);
  }
  nav a:hover {
    color: var(--accent);
  }

  .theme-toggle {
    margin-left: 1.2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: color var(--dur-base) var(--ease), border-color var(--dur-base) var(--ease);
  }
  .theme-toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  main {
    flex: 1;
    padding: 2.5rem 0 4rem;
  }

  /* 内容区：浮在照片上的一整张毛玻璃"纸" */
  .glass-panel {
    background: var(--card);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 2.2rem 2.4rem;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
  }
  @media (max-width: 640px) {
    .glass-panel {
      padding: 1.4rem 1.2rem;
      border-radius: 12px;
    }
  }

  .site-footer {
    border-top: 1px solid var(--border);
    padding: 1.5rem 0;
    text-align: center;
    color: var(--muted);
    font-size: 0.85rem;
    background: color-mix(in srgb, var(--card) 70%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .site-footer a {
    color: var(--muted);
  }
  .site-footer a:hover {
    color: var(--accent);
  }

  /* 代码块：深色底，明暗模式统一（wrapper 样式已随复制按钮移除，
     pre 样式移到文章页 .content :global(pre.astro-code)） */
</style>
