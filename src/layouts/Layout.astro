---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <a href="/">🏠 我的博客</a>
    </header>
    <main>
      <slot />
    </main>
    <style>
      body {
        font-family: system-ui, sans-serif;
        max-width: 720px;
        margin: 0 auto;
        padding: 1rem 1.5rem;
        line-height: 1.7;
      }
      a { color: #2563eb; }
    </style>
  </body>
</html>