---
interface Props {
  title: string;
  /** 首页等页面可加宽显示区域 */
  wide?: boolean;
  /** 文章页：更宽的正文区 */
  articleWide?: boolean;
  /** 是否用整张毛玻璃面板包裹内容（首页用独立卡片时关掉） */
  panel?: boolean;
}
const { title, wide, articleWide, panel = true } = Astro.props;
const year = new Date().getFullYear();
import { siteConfig } from "../config";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · 我的博客</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="我的博客" href="/rss.xml" />
    <!-- 主题初始化：在任何内容渲染前应用，防止刷新闪烁 (FOUC) -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (t === "light" || t === "dark") {
            document.documentElement.dataset.theme = t;
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="logo">fsjdg的空间</a>
        <nav>
          <a href="/">首页</a>
          <a href="/archive/">目录</a>
          <a href="https://github.com/FSJGDJ" target="_blank" rel="noopener"
            >GitHub</a
          >
          <button class="theme-toggle" type="button" aria-label="切换明暗模式">
            <svg
              class="icon-sun"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path
                d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
              ></path>
            </svg>
            <svg
              class="icon-moon"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>
    <main class:list={["container", { "container-wide": wide, "container-article": articleWide }]}>
      {panel ? <div class="glass-panel"><slot /></div> : <slot />}
    </main>
    <!-- glass-panel 的 backdrop-filter 会劫持后代 fixed 定位，
         需要真正相对视口悬浮的元素（如文章目录）从这里渲染 -->
    <slot name="toc" />
    <footer class="site-footer">
      <p>
        © {year} 我的博客 · <a href="https://github.com/FSJGDJ" target="_blank"
          rel="noopener">GitHub</a
        > · <a href="/rss.xml">RSS</a>
        {siteConfig.email && (
          <>
            {" "}· <a href={`mailto:${siteConfig.email}`}>邮箱</a>
          </>
        )}
        · Powered by <a
          href="https://astro.build"
          target="_blank"
          rel="noopener">Astro</a
        >
      </p>
    </footer>

    <!-- 明暗切换：data-theme 优先，其次跟随系统 -->
    <script>
      (function () {
        const btn = document.querySelector(".theme-toggle");
        if (!btn) return;
        const mq = window.matchMedia("(prefers-color-scheme: dark)");

        function resolved() {
          const t = document.documentElement.dataset.theme;
          if (t === "light" || t === "dark") return t;
          return mq.matches ? "dark" : "light";
        }

        function updateIcon() {
          const dark = resolved() === "dark";
          btn.querySelector(".icon-sun").toggleAttribute("hidden", !dark);
          btn.querySelector(".icon-moon").toggleAttribute("hidden", dark);
          btn.setAttribute(
            "aria-label",
            dark ? "切换到亮色模式" : "切换到暗色模式",
          );
        }

        btn.addEventListener("click", () => {
          const next = resolved() === "dark" ? "light" : "dark";
          document.documentElement.dataset.theme = next;
          try {
            localStorage.setItem("theme", next);
          } catch (e) {}
          updateIcon();
        });

        mq.addEventListener("change", () => {
          // 用户未手动选择时，跟随系统变化
          if (!document.documentElement.dataset.theme) updateIcon();
        });

        updateIcon();
      })();
    </script>
  </body>
</html>

<style>
  :root,
  [data-theme="light"] {
    --bg: #fafafa;
    --card: rgba(255, 255, 255, 0.72);
    --text: #1f2328;
    --muted: #5b6470;
    --accent: #4f46e5;
    --border: rgba(229, 231, 235, 0.9);
    --code-bg: #0d1117;
    --code-text: #e6edf3;
    --font-mono:
      "JetBrains Mono", "Cascadia Code", Consolas, "SFMono-Regular",
      Menlo, monospace;
    --font-serif:
      "Source Han Serif SC", "Noto Serif SC", "Songti SC", "STSong",
      "SimSun", serif;
  }

  /* 系统暗色模式自动切换（未手动选择时生效） */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #111114;
      --card: rgba(23, 26, 33, 0.74);
      --text: #e6e8ee;
      --muted: #a8b3bd;
      --accent: #a5b4fc;
      --border: rgba(42, 47, 58, 0.9);
      --code-bg: #0d1117;
      --code-text: #e6edf3;
    }
  }

  [data-theme="dark"] {
    --bg: #111114;
    --card: rgba(23, 26, 33, 0.74);
    --text: #e6e8ee;
    --muted: #a8b3bd;
    --accent: #a5b4fc;
    --border: rgba(42, 47, 58, 0.9);
    --code-bg: #0d1117;
    --code-text: #e6edf3;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  /* 全屏固定背景图：云海山峦 */
  body::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -2;
    background: url("/images/bg.jpg") center / cover no-repeat;
  }
  /* 可读性遮罩：亮色蒙白纱、暗色蒙深纱，保证文字可读又不盖死照片 */
  body::after {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -1;
    background: rgba(250, 250, 250, 0.45);
  }
  :global(html[data-theme="dark"]) body::after {
    background: rgba(17, 17, 20, 0.55);
  }
  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme="light"])) body::after {
      background: rgba(17, 17, 20, 0.55);
    }
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family:
      system-ui,
      -apple-system,
      "PingFang SC",
      "Microsoft YaHei",
      sans-serif;
    line-height: 1.8;
    display: flex;
    min-height: 100vh;
    flex-direction: column;
  }

  /* 标题统一衬线字体，正文保持无衬线，形成中西文混排的杂志感。
     必须 :global——markdown 渲染出的标题不带本组件的 scoped 属性，
     否则会回退成 body 同款无衬线，看上去“小标题像正文一样没有正常显示” */
  :global(h1),
  :global(h2),
  :global(h3) {
    font-family: var(--font-serif);
    font-weight: 600;
    line-height: 1.4;
  }

  .container {
    width: min(680px, 92%);
    margin: 0 auto;
  }
  /* 首页等需要加宽的页面：宽到能容纳 左列表 + 右统计 的分栏 */
  .container-wide {
    width: min(1120px, 96%);
  }
  /* 文章页：更宽的正文区 */
  .container-article {
    width: min(860px, 94%);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    background: color-mix(in srgb, var(--card) 82%, transparent);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.9rem 1.5rem;
  }

  .logo {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--text);
    text-decoration: none;
  }

  nav {
    display: flex;
    align-items: center;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
    margin-left: 1.2rem;
    font-size: 0.95rem;
    transition: color 0.2s;
  }
  nav a:hover {
    color: var(--accent);
  }

  .theme-toggle {
    margin-left: 1.2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
  }
  .theme-toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  main {
    flex: 1;
    padding: 2.5rem 0 4rem;
  }

  /* 内容区：浮在照片上的一整张毛玻璃"纸" */
  .glass-panel {
    background: var(--card);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 2.2rem 2.4rem;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
  }
  @media (max-width: 640px) {
    .glass-panel {
      padding: 1.4rem 1.2rem;
      border-radius: 12px;
    }
  }

  .site-footer {
    border-top: 1px solid var(--border);
    padding: 1.5rem 0;
    text-align: center;
    color: var(--muted);
    font-size: 0.85rem;
    background: color-mix(in srgb, var(--card) 70%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .site-footer a {
    color: var(--muted);
  }
  .site-footer a:hover {
    color: var(--accent);
  }

  /* 代码块：深色底，明暗模式统一（wrapper 样式已随复制按钮移除，
     pre 样式移到文章页 .content :global(pre.astro-code)） */
</style>
