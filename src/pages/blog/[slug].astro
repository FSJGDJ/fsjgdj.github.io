---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id } }));
}

const post = (await getCollection("blog")).find(
  (p) => p.id === Astro.params.slug,
);
if (!post) return Astro.redirect("/");

const { Content, headings } = await render(post);

// 目录只收 h2 / h3，并组装成嵌套树（h3 挂在最近的 h2 之下）
type TocItem = {
  h: (typeof headings)[number];
  children: (typeof headings)[number][];
};
const tocTree: TocItem[] = [];
for (const h of headings) {
  if (h.depth === 2) {
    tocTree.push({ h, children: [] });
  } else if (h.depth === 3) {
    if (tocTree.length > 0) {
      tocTree[tocTree.length - 1].children.push(h);
    } else {
      tocTree.push({ h, children: [] });
    }
  }
}

// 中文约 400 字/分钟，估算阅读时长
const readingTime = Math.max(1, Math.ceil(post.body.length / 400));
---

<Layout title={post.data.title} articleWide>
  <article class="post">
    <a href="/" class="back">← 返回首页</a>
    <h1>{post.data.title}</h1>
    <div class="post-meta">
      <time>{post.data.pubDate.toLocaleDateString("zh-CN")}</time>
      <span class="dot">·</span>
      <span>约 {readingTime} 分钟</span>
    </div>
    {
      post.data.tags.length > 0 && (
        <div class="tags">
          {post.data.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )
    }

    {
      tocTree.length > 0 && (
        <details class="toc toc-mobile">
          <summary class="toc-title">目录</summary>
          <ol>
            {tocTree.map((item) => (
              <li class="depth-2">
                <a href={`#${item.h.slug}`}>{item.h.text}</a>
                {item.children.length > 0 && (
                  <ol>
                    {item.children.map((c) => (
                      <li class="depth-3">
                        <a href={`#${c.slug}`}>{c.text}</a>
                      </li>
                    ))}
                  </ol>
                )}
              </li>
            ))}
          </ol>
        </details>
      )
    }

    <div class="content">
      <Content />
    </div>

    {
      tocTree.length > 0 && (
        <>
          <details class="toc toc-desktop" id="toc-panel" open aria-label="文章目录">
            <summary class="toc-title">目录</summary>
            <ol>
              {tocTree.map((item) => (
                <li class="depth-2">
                  <a href={`#${item.h.slug}`}>{item.h.text}</a>
                  {item.children.length > 0 && (
                    <ol>
                      {item.children.map((c) => (
                        <li class="depth-3">
                          <a href={`#${c.slug}`}>{c.text}</a>
                        </li>
                      ))}
                    </ol>
                  )}
                </li>
              ))}
            </ol>
          </details>
          <button
            class="toc-toggle"
            id="toc-toggle"
            type="button"
            aria-controls="toc-panel"
            aria-expanded="true"
            aria-label="收起目录"
            title="收起目录"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m15 18-6-6 6-6"></path>
            </svg>
          </button>
        </>
      )
    }
  </article>
</Layout>

<script>
  // 目录当前章节高亮 + 子条目随滚动收起/展开：
  // h3 默认收起，滚动到哪个 h2 章节就展开哪个章节的 h3 子条目
  (function () {
    const links = document.querySelectorAll<HTMLAnchorElement>(".toc a[href^='#']");
    if (links.length === 0) return;
    const map = new Map<Element, HTMLAnchorElement>();
    links.forEach((link) => {
      const target = document.getElementById(decodeURIComponent(link.hash.slice(1)));
      if (target) map.set(target, link);
    });

    // 按 h2 分组收集 h3 子条目（目录为嵌套列表渲染）
    const groups = new Map<HTMLLIElement, HTMLLIElement[]>();
    const h3ToH2 = new Map<HTMLLIElement, HTMLLIElement>();
    document
      .querySelectorAll<HTMLLIElement>(".toc li.depth-2")
      .forEach((h2li) => {
        const subs = Array.from(
          h2li.querySelectorAll<HTMLLIElement>(":scope > ol > li.depth-3"),
        );
        groups.set(h2li, subs);
        subs.forEach((s) => h3ToH2.set(s, h2li));
      });

    function updateGroups(activeLi: HTMLLIElement | null) {
      // 激活项若为 h3，展开它所属的 h2 分组
      let target: HTMLLIElement | null = activeLi;
      if (target?.classList.contains("depth-3")) {
        target = h3ToH2.get(target) ?? null;
      }
      groups.forEach((subs, h2li) => {
        const open = h2li === target;
        subs.forEach((sub) => sub.classList.toggle("toc-show", open));
      });
    }

    let activeHash: string | null = null;
    function setActive(link: HTMLAnchorElement | null) {
      const hash = link?.hash ?? null;
      if (activeHash === hash) return;
      activeHash = hash;
      // 移动/桌面两份目录里相同锚点的链接同步高亮
      links.forEach((l) => l.classList.toggle("active", l.hash === hash && !!hash));
      updateGroups(link?.closest("li") ?? null);
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            setActive(map.get(entry.target) ?? null);
          }
        }
      },
      { rootMargin: "-20% 0px -70% 0px" },
    );
    map.forEach((_, target) => observer.observe(target));
  })();

  // 目录面板收起/展开：点击把手按钮手动切换（记忆到 localStorage）
  (function () {
    const toc = document.querySelector<HTMLElement>(".toc-desktop");
    const btn = document.querySelector<HTMLButtonElement>(".toc-toggle");
    if (!toc || !btn) return;

    const KEY = "toc-collapsed";
    let collapsed = localStorage.getItem(KEY) === "1";

    function apply() {
      toc!.classList.toggle("toc-collapsed", collapsed);
      btn!.classList.toggle("is-collapsed", collapsed);
      const label = collapsed ? "展开目录" : "收起目录";
      btn!.setAttribute("aria-label", label);
      btn!.setAttribute("title", label);
      btn!.setAttribute("aria-expanded", String(!collapsed));
    }
    apply();

    btn.addEventListener("click", () => {
      collapsed = !collapsed;
      localStorage.setItem(KEY, collapsed ? "1" : "0");
      apply();
    });
  })();
</script>

<style>
  .back {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9rem;
  }
  .back:hover {
    color: var(--accent);
  }

  .post h1 {
    font-size: 2rem;
    margin: 1.2rem 0 0.5rem;
  }

  .post-meta {
    color: var(--muted);
    font-size: 0.9rem;
    font-family: var(--font-mono);
  }
  .post-meta .dot {
    margin: 0 0.4rem;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 0.8rem;
  }
  .tag {
    font-size: 0.75rem;
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--muted);
    background: color-mix(in srgb, var(--accent) 6%, transparent);
  }

  /* 目录：窄屏折叠（默认），宽屏右侧 sticky */
  .toc-mobile {
    margin: 1.5rem 0 0;
  }
  /* 目录标题（移动/桌面共用）：点击可收起或展开 */
  .toc-title {
    margin: 0 0 0.5rem;
    font-size: 0.8rem;
    color: var(--muted);
    font-weight: 600;
    letter-spacing: 0.05em;
    cursor: pointer;
    user-select: none;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .toc-title::-webkit-details-marker {
    display: none;
  }
  /* 收起/展开箭头 */
  .toc-title::after {
    content: "▸";
    font-size: 0.7rem;
    transition: transform 0.2s;
  }
  details[open] > .toc-title::after {
    transform: rotate(90deg);
  }
  .toc-desktop {
    display: none;
  }
  /* 目录收起/展开按钮（仅在宽屏存在悬浮目录时显示） */
  .toc-toggle {
    display: none;
  }

  /* 宽屏：目录悬浮在正文左侧（参考 springbot 布局），
     点击按钮可收起/展开，作为面板边缘的“把手” */
  @media (min-width: 1480px) {
    .toc-mobile {
      display: none;
    }
    .toc-desktop {
      display: block;
      position: fixed;
      top: 5.5rem;
      right: min(calc(50% + 445px), calc(100vw - 290px));
      width: 230px;
      max-height: calc(100vh - 8rem);
      overflow-y: auto;
      padding: 0.9rem 1rem;
      border-radius: 12px;
      background: var(--card);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid var(--border);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
      transition:
        transform 0.3s ease,
        opacity 0.3s ease;
    }
    /* 点击按钮手动收起（滚动不再自动收起面板） */
    .toc-desktop.toc-collapsed {
      transform: translateX(-140%);
      opacity: 0;
      pointer-events: none;
    }
    .toc-desktop .toc-title {
      margin-bottom: 0.6rem;
    }

    /* 收起/展开按钮：面板左侧边缘的圆形把手，位置固定在最左边 */
    .toc-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      position: fixed;
      top: 5.5rem;
      left: 14px;
      z-index: 20;
      width: 34px;
      height: 34px;
      padding: 0;
      cursor: pointer;
      border-radius: 999px;
      color: var(--muted);
      background: var(--card);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid var(--border);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
      transition:
        color 0.2s,
        border-color 0.2s;
    }
    .toc-toggle:hover {
      color: var(--accent);
      border-color: var(--accent);
    }
    .toc-toggle svg {
      transition: transform 0.3s ease;
    }
    /* 收起状态：箭头翻转指向右侧，提示可展开 */
    .toc-toggle.is-collapsed svg {
      transform: rotate(180deg);
    }
  }
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 2px solid var(--border);
    counter-reset: toc-n;
  }
  /* h3 嵌套列表：缩进 + 独立引导线 */
  .toc ol ol {
    margin: 0.1rem 0 0.2rem 0.55rem;
  }
  /* 层级编号：h2 显示 1. 2.，h3 显示 1.1. 1.2.（参考 ttdr.top 目录） */
  .toc li > a::before {
    counter-increment: toc-n;
    content: counters(toc-n, ".") ".";
    margin-right: 0.35rem;
    font-size: 0.72em;
    font-family: var(--font-mono);
    color: var(--muted);
    opacity: 0.8;
  }
  .toc li {
    margin: 0;
  }
  .toc a {
    display: block;
    padding: 0.2rem 0 0.2rem 0.8rem;
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--muted);
    text-decoration: none;
    border-left: 2px solid transparent;
    margin-left: -2px;
    transition: color 0.2s, border-color 0.2s;
  }
  .toc li.depth-3 a {
    padding-left: 1.6rem;
    font-size: 0.75rem;
  }
  /* h3 子条目默认收起，所在章节激活时由脚本加 .toc-show 展开 */
  .toc li.depth-3 {
    display: none;
  }
  .toc li.depth-3.toc-show {
    display: block;
  }
  .toc a:hover {
    color: var(--accent);
  }
  .toc a.active {
    color: var(--accent);
    border-left-color: var(--accent);
  }

  /* 正文去卡片容器，直接排版在背景上，长文像一页纸 */
  .content {
    margin-top: 2rem;
    font-size: 1rem;
    line-height: 1.75;
  }

  .content :global(h2) {
    margin-top: 2rem;
    font-size: 1.5rem;
  }
  .content :global(h3) {
    margin-top: 1.5rem;
    font-size: 1.25rem;
  }
  .content :global(h2),
  .content :global(h3) {
    /* 锚点偏移，避免被 sticky 头部遮挡 */
    scroll-margin-top: 4.5rem;
  }
  .content :global(p) {
    margin: 1rem 0;
  }
  .content :global(a) {
    color: var(--accent);
  }
  .content :global(code) {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
    padding: 0.15em 0.4em;
    border-radius: 6px;
    font-size: 0.9em;
    font-family: var(--font-mono);
  }
  /* 代码块内的 code 不用行内样式 */
  .content :global(pre code) {
    background: transparent;
    color: inherit;
    padding: 0;
    border-radius: 0;
    font-size: inherit;
  }
  .content :global(blockquote) {
    border-left: 4px solid var(--accent);
    margin: 1.2rem 0;
    padding: 0.4rem 1.2rem;
    color: var(--muted);
    background: color-mix(in srgb, var(--accent) 6%, transparent);
    border-radius: 0 8px 8px 0;
  }
  .content :global(img) {
    max-width: 100%;
    border-radius: 10px;
  }
  .content :global(table) {
    border-collapse: collapse;
    width: 100%;
    margin: 1.2rem 0;
    font-size: 0.9rem;
  }
  .content :global(th),
  .content :global(td) {
    border: 1px solid var(--border);
    padding: 0.4rem 0.7rem;
    text-align: left;
  }
  .content :global(th) {
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }
</style>
