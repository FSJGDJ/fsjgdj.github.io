---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { getPostStats } from "../../utils/postStats";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id } }));
}

const post = (await getCollection("blog")).find(
  (p) => p.id === Astro.params.slug,
);
if (!post) return Astro.redirect("/");

const { Content, headings } = await render(post);

// 目录只收 h2 / h3（第一版：扁平列表）
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

// 与首页卡片同一口径的阅读时长（正文自动统计）
const { minutes: readingTime } = getPostStats(post.body ?? "");
---

<Layout title={post.data.title} articleWide>
  <article class="post">
    <a href="/" class="back">← 返回首页</a>
    <h1>{post.data.title}</h1>
    <div class="post-meta">
      <time>{post.data.pubDate.toLocaleDateString("zh-CN")}</time>
      <span class="dot">·</span>
      <span>约 {readingTime} 分钟</span>
    </div>
    {
      post.data.tags.length > 0 && (
        <div class="tags">
          {post.data.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )
    }

    {
      toc.length > 0 && (
        <details class="toc toc-mobile">
          <summary class="toc-title">目录</summary>
          <ol>
            {toc.map((h) => (
              <li class={`depth-${h.depth}`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </details>
      )
    }
    <div class="content">
      <Content />
    </div>
  </article>

  {/* 桌面目录通过命名插槽渲染到 glass-panel 之外，
      否则面板的 backdrop-filter 会劫持 fixed 定位（相对面板而非视口） */}
  {toc.length > 0 && (
    <Fragment slot="toc">
      <aside class="toc toc-desktop" aria-label="文章目录">
        <p class="toc-title">目录</p>
        <ol>
          {toc.map((h) => (
            <li class={`depth-${h.depth}`}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ol>
      </aside>
    </Fragment>
  )}
</Layout>

<script>
  // 目录：滚动时高亮当前章节（第一版形态：扁平列表 + 高亮跟随）
  (function () {
    const links = document.querySelectorAll<HTMLAnchorElement>(".toc a[href^='#']");
    if (links.length === 0) return;

    // 标题元素与锚点（去重，保持文档顺序）
    const pairs: { el: HTMLElement; hash: string }[] = [];
    const seen = new Set<string>();
    links.forEach((link) => {
      const el = document.getElementById(decodeURIComponent(link.hash.slice(1)));
      if (el && !seen.has(link.hash)) {
        seen.add(link.hash);
        pairs.push({ el, hash: link.hash });
      }
    });

    let activeHash: string | null = null;
    function setActive(hash: string | null) {
      if (activeHash === hash) return;
      activeHash = hash;
      // 移动/桌面两份目录里相同锚点的链接同步高亮
      links.forEach((l) => l.classList.toggle("active", !!hash && l.hash === hash));
    }

    // 滚动驱动的激活计算：取“顶部参考线”之上的最后一个标题，
    // 相比 IntersectionObserver 不会出现章节间隙期间高亮滞留或跳变
    const HEADER_OFFSET = 96; // sticky 头部高度 + 余量
    let ticking = false;
    function computeActive() {
      let current: string | null = null;
      for (const { el, hash } of pairs) {
        if (el.getBoundingClientRect().top <= HEADER_OFFSET) current = hash;
        else break;
      }
      // 接近页面底部时锁定最后一个标题
      const doc = document.documentElement;
      if (
        doc.scrollHeight - window.scrollY - window.innerHeight < 80 &&
        pairs.length > 0
      ) {
        current = pairs[pairs.length - 1].hash;
      }
      setActive(current);
    }
    window.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          computeActive();
          ticking = false;
        });
      },
      { passive: true },
    );
    computeActive();
  })();

  // 正文图片 Lightbox：点击放大；遮罩/关闭按钮/ESC 退出；
  // 箭头按钮与方向键切换；移动端左右滑动切换
  (function () {
    const imgs = Array.from(
      document.querySelectorAll<HTMLImageElement>(".content img"),
    );
    if (imgs.length === 0) return;

    // 遮罩层运行时创建并挂到 body 下，避开 glass-panel 的
    // backdrop-filter 对后代 fixed 定位的劫持
    const overlay = document.createElement("div");
    overlay.className = "lightbox";
    overlay.setAttribute("role", "dialog");
    overlay.setAttribute("aria-modal", "true");
    overlay.setAttribute("aria-label", "图片预览");
    overlay.innerHTML = `
      <button class="lb-close" type="button" aria-label="关闭预览" title="关闭 (ESC)">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12"></path>
        </svg>
      </button>
      <button class="lb-arrow lb-prev" type="button" aria-label="上一张" title="上一张 (←)">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m15 18-6-6 6-6"></path>
        </svg>
      </button>
      <img class="lb-view" alt="" />
      <button class="lb-arrow lb-next" type="button" aria-label="下一张" title="下一张 (→)">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m9 18 6-6-6-6"></path>
        </svg>
      </button>
      <p class="lb-counter" aria-live="polite"></p>
    `;
    document.body.appendChild(overlay);

    const view = overlay.querySelector<HTMLImageElement>(".lb-view")!;
    const counter = overlay.querySelector<HTMLElement>(".lb-counter")!;
    const btnClose = overlay.querySelector<HTMLButtonElement>(".lb-close")!;
    const btnPrev = overlay.querySelector<HTMLButtonElement>(".lb-prev")!;
    const btnNext = overlay.querySelector<HTMLButtonElement>(".lb-next")!;

    let index = 0;
    let isOpen = false;
    const multi = imgs.length > 1;

    function render() {
      const img = imgs[index];
      view.src = img.currentSrc || img.src;
      view.alt = img.alt || "";
      counter.textContent = `${index + 1} / ${imgs.length}`;
      // 单张图片时隐藏切换箭头
      btnPrev.style.display = multi ? "" : "none";
      btnNext.style.display = multi ? "" : "none";
    }

    function open(i: number) {
      index = i;
      render();
      overlay.classList.add("open");
      document.body.style.overflow = "hidden"; // 锁定背景滚动
      isOpen = true;
    }

    function close() {
      overlay.classList.remove("open");
      document.body.style.overflow = "";
      isOpen = false;
    }

    function step(delta: number) {
      if (!multi) return;
      index = (index + delta + imgs.length) % imgs.length;
      render();
    }

    imgs.forEach((img, i) => {
      img.addEventListener("click", (e) => {
        e.preventDefault();
        open(i);
      });
    });

    // 点击遮罩（非图片/按钮区域）退出
    overlay.addEventListener("click", (e) => {
      if (e.target === overlay) close();
    });
    btnClose.addEventListener("click", close);
    btnPrev.addEventListener("click", () => step(-1));
    btnNext.addEventListener("click", () => step(1));

    document.addEventListener("keydown", (e) => {
      if (!isOpen) return;
      if (e.key === "Escape") close();
      else if (e.key === "ArrowLeft") step(-1);
      else if (e.key === "ArrowRight") step(1);
    });

    // 移动端滑动手势切换
    let touchX = 0;
    overlay.addEventListener(
      "touchstart",
      (e) => {
        touchX = e.changedTouches[0].clientX;
      },
      { passive: true },
    );
    overlay.addEventListener(
      "touchend",
      (e) => {
        const dx = e.changedTouches[0].clientX - touchX;
        if (Math.abs(dx) < 40) return; // 小于阈值视为点击
        step(dx < 0 ? 1 : -1);
      },
      { passive: true },
    );
  })();
</script>

<style>
  .back {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9rem;
  }
  .back:hover {
    color: var(--accent);
  }

  .post h1 {
    font-size: 2rem;
    margin: 1.2rem 0 0.5rem;
  }

  .post-meta {
    color: var(--muted);
    font-size: 0.9rem;
    font-family: var(--font-mono);
  }
  .post-meta .dot {
    margin: 0 0.4rem;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 0.8rem;
  }
  .tag {
    font-size: 0.75rem;
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--muted);
    background: color-mix(in srgb, var(--accent) 6%, transparent);
  }

  /* 目录：窄屏折叠（默认），宽屏右侧 sticky */
  .toc-mobile {
    margin: 1.5rem 0 0;
  }
  /* 目录标题：移动端 summary 可点击收起展开；桌面端为静态标题 */
  .toc-title {
    margin: 0 0 0.5rem;
    font-size: 0.8rem;
    color: var(--muted);
    font-weight: 600;
    letter-spacing: 0.05em;
  }
  .toc-mobile .toc-title {
    cursor: pointer;
    user-select: none;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .toc-mobile .toc-title::-webkit-details-marker {
    display: none;
  }
  /* 收起/展开箭头（仅移动端折叠目录） */
  .toc-mobile .toc-title::after {
    content: "▸";
    font-size: 0.7rem;
    transition: transform 0.2s;
  }
  .toc-mobile details[open] > .toc-title::after,
  .toc-mobile[open] > .toc-title::after {
    transform: rotate(90deg);
  }
  .toc-desktop {
    display: none;
  }

  /* 宽屏：目录悬浮在正文左侧（第一版形态），扁平列表始终完整可见 */
  @media (min-width: 1400px) {
    .toc-mobile {
      display: none;
    }
    /* 正文整体右移，与左侧目录之间留出充足留白（参考 springbot 布局）。
       注意：Layout 的 .container 规则带 scoped 属性选择器（优先级 0,2,0），
       这里必须用更高优先级的选择器才能盖过它的 margin: 0 auto */
    :global(main.container.container-article) {
      margin-left: max(300px, calc(50% - 280px));
    }
    .toc-desktop {
      display: block;
      position: fixed;
      top: 5.5rem;
      left: min(calc(50% - 675px), calc(100vw - 250px));
      width: 230px;
      max-height: calc(100vh - 8rem);
      overflow-y: auto;
      padding: 0.9rem 1rem;
      border-radius: 12px;
      background: var(--card);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid var(--border);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
    }
    .toc-desktop .toc-title {
      margin-bottom: 0.6rem;
    }
  }
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 2px solid var(--border);
  }
  .toc li {
    margin: 0;
  }
  .toc a {
    display: block;
    padding: 0.2rem 0.4rem 0.2rem 0.8rem;
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--muted);
    text-decoration: none;
    border-left: 2px solid transparent;
    border-radius: 0 6px 6px 0;
    margin-left: -2px;
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background-color 0.2s ease;
  }
  .toc li.depth-3 a {
    padding-left: 1.6rem;
    font-size: 0.75rem;
  }
  .toc a:hover {
    color: var(--accent);
  }
  .toc a.active {
    color: var(--accent);
    border-left-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  /* 减弱动态效果：目录的所有过渡直接跳过 */
  @media (prefers-reduced-motion: reduce) {
    .toc a,
    .toc-title::after {
      transition: none;
    }
  }

  /* 正文去卡片容器，直接排版在背景上，长文像一页纸 */
  .content {
    margin-top: 2rem;
    font-size: 1rem;
    line-height: 1.75;
  }

  .content :global(h2) {
    margin-top: 2rem;
    font-size: 1.5rem;
  }
  .content :global(h3) {
    margin-top: 1.5rem;
    font-size: 1.25rem;
  }
  .content :global(h2),
  .content :global(h3) {
    /* 锚点偏移，避免被 sticky 头部遮挡 */
    scroll-margin-top: 4.5rem;
  }
  .content :global(p) {
    margin: 1rem 0;
  }
  .content :global(a) {
    color: var(--accent);
  }
  .content :global(code) {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
    padding: 0.15em 0.4em;
    border-radius: 6px;
    font-size: 0.9em;
    font-family: var(--font-mono);
  }
  /* 代码块：深色底（!important 压过 shiki 内联背景色） */
  .content :global(pre.astro-code) {
    margin: 1.2rem 0;
    background: var(--code-bg) !important;
    color: var(--code-text) !important;
    border-radius: 10px;
    padding: 1rem;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.7;
  }
  /* 代码块内的 code 不用行内样式 */
  .content :global(pre code) {
    background: transparent;
    color: inherit;
    padding: 0;
    border-radius: 0;
    font-size: inherit;
  }
  .content :global(blockquote) {
    border-left: 4px solid var(--accent);
    margin: 1.2rem 0;
    padding: 0.4rem 1.2rem;
    color: var(--muted);
    background: color-mix(in srgb, var(--accent) 6%, transparent);
    border-radius: 0 8px 8px 0;
  }
  .content :global(img) {
    max-width: 100%;
    border-radius: 10px;
    cursor: zoom-in;
  }

  /* Lightbox 遮罩层（运行时挂到 body，须用 :global） */
  :global(.lightbox) {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(10, 12, 18, 0.88);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.25s ease,
      visibility 0s 0.25s;
  }
  :global(.lightbox.open) {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.25s ease;
  }
  :global(.lb-view) {
    max-width: min(92vw, 1200px);
    max-height: 84vh;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 16px 64px rgba(0, 0, 0, 0.5);
    cursor: default;
  }
  :global(.lb-close),
  :global(.lb-arrow) {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.85);
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }
  :global(.lb-close:hover),
  :global(.lb-arrow:hover) {
    background: rgba(255, 255, 255, 0.25);
    color: #fff;
  }
  :global(.lb-close) {
    top: 1.2rem;
    right: 1.2rem;
  }
  :global(.lb-arrow) {
    top: 50%;
    transform: translateY(-50%);
  }
  :global(.lb-prev) {
    left: 1.2rem;
  }
  :global(.lb-next) {
    right: 1.2rem;
  }
  :global(.lb-counter) {
    position: absolute;
    bottom: 1.2rem;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.7);
  }
  /* 小屏：图片几乎满屏，箭头缩小贴边，切换主要靠滑动 */
  @media (max-width: 640px) {
    :global(.lb-view) {
      max-width: 96vw;
      max-height: 78vh;
    }
    :global(.lb-arrow) {
      width: 34px;
      height: 34px;
    }
    :global(.lb-prev) {
      left: 0.5rem;
    }
    :global(.lb-next) {
      right: 0.5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.lightbox),
    :global(.lightbox.open),
    :global(.lb-close),
    :global(.lb-arrow) {
      transition: none;
    }
  }
  .content :global(table) {
    border-collapse: collapse;
    width: 100%;
    margin: 1.2rem 0;
    font-size: 0.9rem;
  }
  .content :global(th),
  .content :global(td) {
    border: 1px solid var(--border);
    padding: 0.4rem 0.7rem;
    text-align: left;
  }
  .content :global(th) {
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }
</style>
