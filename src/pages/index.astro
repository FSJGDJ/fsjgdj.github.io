---
import Layout from "../layouts/Layout.astro";
import PostFeed from "../components/PostFeed.astro";
import { getCollection } from "astro:content";
import { siteConfig } from "../config";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const pageSize = siteConfig.pageSize;
const totalPages = Math.max(1, Math.ceil(posts.length / pageSize));
const pagePosts = posts.slice(0, pageSize);
---

<Layout
  title="首页"
  description={`${siteConfig.siteName}：${siteConfig.description}`}
  wide
  panel={false}
  drift
>
  <Fragment slot="hero">
    <section class="landing">
      <img
        class="avatar"
        src={siteConfig.avatar}
        alt={`${siteConfig.name} 的头像`}
        width="96"
        height="96"
      />
      <h1>{siteConfig.name}</h1>
      <p class="subtitle">{siteConfig.tagline}</p>
      {siteConfig.motto && <p class="motto">{siteConfig.motto}</p>}
      <div class="social">
        <a
          href="https://github.com/FSJGDJ"
          target="_blank"
          rel="noopener"
          aria-label="GitHub"
          title="GitHub"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2.17c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.72-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11.1 11.1 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.05.77 2.12v3.14c0 .31.21.68.8.56A11.52 11.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"
            ></path>
          </svg>
        </a>
        {
          siteConfig.email && (
            <a href={`mailto:${siteConfig.email}`} aria-label="邮箱" title="邮箱">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                <path d="m22 7-10 6L2 7"></path>
              </svg>
            </a>
          )
        }
      </div>
      <a href="#posts" class="scroll-hint" aria-label="向下滚动查看文章">
        <svg
          width="30"
          height="30"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m6 9 6 6 6-6"></path>
        </svg>
      </a>
    </section>
  </Fragment>

  <PostFeed
    posts={pagePosts}
    currentPage={1}
    totalPages={totalPages}
    nextUrl={totalPages > 1 ? "/page/2/" : undefined}
  />
</Layout>

<style>
  /* 首屏 Landing：全屏居中个人信息，滚动后进入双栏文章区 */
  .landing {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    gap: 0.4rem;
    padding: 2rem 1.25rem 4rem;
  }
  .avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    margin-bottom: 1rem;
    border: 1px solid var(--border);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
  }
  .landing h1 {
    font-size: 2.4rem;
    margin: 0;
    color: var(--text);
  }
  .subtitle {
    color: var(--muted);
    margin: 0;
  }
  .motto {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text);
    margin: 1.2rem 0 0;
    line-height: 1.6;
  }

  .social {
    display: flex;
    gap: 0.9rem;
    margin-top: 1.2rem;
  }
  .social a {
    display: inline-flex;
    padding: 0.45rem;
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--muted);
    transition: color var(--dur-base) var(--ease), border-color var(--dur-base) var(--ease);
  }
  .social a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* 底部下滑箭头：轻微上下浮动 */
  .scroll-hint {
    position: absolute;
    bottom: 0.6rem;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    padding: 0.5rem;
    color: var(--muted);
    transition: color var(--dur-base) var(--ease);
  }
  .scroll-hint:hover {
    color: var(--accent);
  }
  .scroll-hint svg {
    animation: bounce-down 2.2s ease-in-out infinite;
  }
  @keyframes bounce-down {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(8px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-hint svg {
      animation: none;
    }
  }

  /* 首屏首次加载轻微淡入 */
  .landing {
    animation: hero-fade-in 0.7s ease-out both;
  }
  @keyframes hero-fade-in {
    from {
      opacity: 0;
      transform: translateY(-0.75rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .landing {
      animation: none;
    }
  }
</style>
