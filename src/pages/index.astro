---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { siteConfig } from "../config";
import { getPostStats } from "../utils/postStats";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// 侧栏统计：文章数 / 标签数 / 运行天数（自最早一篇文章起算，构建时计算）
const tagSet = new Set<string>();
for (const p of posts) for (const t of p.data.tags ?? []) tagSet.add(t);
const earliest = posts[posts.length - 1]?.data.pubDate ?? new Date();
const runDays = Math.max(
  1,
  Math.floor((Date.now() - earliest.valueOf()) / 86400000),
);

// 当前路径：侧边导航高亮当前页
const pathname = Astro.url.pathname;
---

<Layout title="首页" wide panel={false}>
  <script is:inline>
    // 进场动画前置标记：JS 可用时才隐藏待入场元素，避免无 JS 时内容不可见
    document.documentElement.classList.add("js");
  </script>
  <section class="landing reveal">
    <img
      class="avatar"
      src={siteConfig.avatar}
      alt={`${siteConfig.name} 的头像`}
      width="96"
      height="96"
    />
    <h1>{siteConfig.name}</h1>
    <p class="subtitle">{siteConfig.tagline}</p>
    {
      siteConfig.motto && <p class="motto">{siteConfig.motto}</p>
    }
    <div class="social">
      <a
        href="https://github.com/FSJGDJ"
        target="_blank"
        rel="noopener"
        aria-label="GitHub"
        title="GitHub"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2.17c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.72-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11.1 11.1 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.05.77 2.12v3.14c0 .31.21.68.8.56A11.52 11.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"
          ></path>
        </svg>
      </a>
      {
        siteConfig.email && (
          <a href={`mailto:${siteConfig.email}`} aria-label="邮箱" title="邮箱">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="2" y="4" width="20" height="16" rx="2"></rect>
              <path d="m22 7-10 6L2 7"></path>
            </svg>
          </a>
        )
      }
    </div>
    <a href="#posts" class="scroll-hint" aria-label="向下滚动查看文章">
      <svg
        width="30"
        height="30"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m6 9 6 6 6-6"></path>
      </svg>
    </a>
  </section>

  <section id="posts" class="posts">
    <div class="posts-layout">
      <aside class="author reveal" aria-label="作者信息与站点导航">
        <div class="author-card">
          <img
            class="author-avatar"
            src={siteConfig.avatar}
            alt={`${siteConfig.name} 的头像`}
            width="72"
            height="72"
          />
          <div class="author-text">
            <p class="author-name">{siteConfig.name}</p>
            <p class="author-bio">渴望成为大手子</p>
            <p class="author-motto">学习记录和个人兴趣</p>
          </div>
          <div class="author-stats">
            <div class="author-stat">
              <span class="num">{posts.length}</span>
              <span class="label">文章</span>
            </div>
            <div class="author-stat">
              <span class="num">{tagSet.size}</span>
              <span class="label">标签</span>
            </div>
            <div class="author-stat">
              <span class="num">{runDays}</span>
              <span class="label">天</span>
            </div>
          </div>
          <div class="author-links">
            <a
              href="https://github.com/FSJGDJ"
              target="_blank"
              rel="noopener"
              aria-label="GitHub"
              title="GitHub"
            >
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2.17c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.72-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11.1 11.1 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.05.77 2.12v3.14c0 .31.21.68.8.56A11.52 11.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"
                ></path>
              </svg>
            </a>
            {
              siteConfig.email && (
                <a
                  href={`mailto:${siteConfig.email}`}
                  aria-label="邮箱"
                  title="邮箱"
                >
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                    <path d="m22 7-10 6L2 7"></path>
                  </svg>
                </a>
              )
            }
            <a href="/rss.xml" aria-label="RSS 订阅" title="RSS 订阅">
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M4 11a9 9 0 0 1 9 9"></path>
                <path d="M4 4a16 16 0 0 1 16 16"></path>
                <circle cx="5" cy="19" r="1"></circle>
              </svg>
            </a>
          </div>
        </div>

        <nav class="side-nav" aria-label="侧边导航">
          <a href="/" class={pathname === "/" ? "active" : ""}>
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <path d="M9 22V12h6v10"></path>
            </svg>
            <span>首页</span>
          </a>
          <a
            href="/archive/"
            class={pathname.startsWith("/archive") ? "active" : ""}
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="3" y="4" width="18" height="4" rx="1"></rect>
              <path d="M5 8v11a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8"></path>
              <path d="M10 12h4"></path>
            </svg>
            <span>归档</span>
          </a>
        </nav>
      </aside>

      <ul class="post-list">
      {
        posts.map((post, i) => {
          const stats = getPostStats(post.body ?? "");
          return (
          <li
            class="reveal"
            style={`transition-delay:${Math.min(i, 8) * 90}ms`}
          >
            <a class="post-card" href={`/blog/${post.id}`}>
              <div class="post-meta">
                <time>{post.data.pubDate.toLocaleDateString("zh-CN")}</time>
                <span class="dot">·</span>
                <span>{stats.words.toLocaleString("en-US")} 字</span>
                <span class="dot">·</span>
                <span>{stats.minutes} 分钟</span>
              </div>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
              <div class="post-footer">
                {post.data.tags?.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
                <span class="read-more">阅读全文 →</span>
              </div>
            </a>
          </li>
          );
        })
      }
    </ul>
    </div>
  </section>
</Layout>

<script>
  // 进场动画：条目进入视口时上浮淡入（参考 fadeInUp，逐条错开）
  const reveals = document.querySelectorAll<HTMLElement>(".reveal");
  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.08 },
    );
    reveals.forEach((el) => observer.observe(el));
  } else {
    reveals.forEach((el) => el.classList.add("visible"));
  }
</script>

<style>
  /* 首屏 Landing：整屏照片 + 居中个人信息，滚动后才见文章 */
  .landing {
    position: relative;
    min-height: calc(100svh - 10rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    gap: 0.4rem;
    padding: 1rem 0 3.5rem;
  }
  .avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    margin-bottom: 1rem;
    border: 1px solid var(--border);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
  }
  .landing h1 {
    font-size: 2.4rem;
    margin: 0;
    color: var(--text);
  }
  .subtitle {
    color: var(--muted);
    margin: 0;
  }
  .motto {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text);
    margin: 1.2rem 0 0;
    line-height: 1.6;
  }

  .social {
    display: flex;
    gap: 0.9rem;
    margin-top: 1.2rem;
  }
  .social a {
    display: inline-flex;
    padding: 0.45rem;
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--muted);
    transition: color 0.2s, border-color 0.2s;
  }
  .social a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* 底部下滑箭头：轻微上下浮动 */
  .scroll-hint {
    position: absolute;
    bottom: 0.6rem;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    padding: 0.5rem;
    color: var(--muted);
    transition: color 0.2s;
  }
  .scroll-hint:hover {
    color: var(--accent);
  }
  .scroll-hint svg {
    animation: bounce-down 2.2s ease-in-out infinite;
  }
  @keyframes bounce-down {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(8px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-hint svg {
      animation: none;
    }
  }

  /* 文章区：滚过首屏后出现；宽屏为 左作者名片 + 右列表 分栏 */
  .posts {
    margin-top: 2rem;
    scroll-margin-top: 5rem;
  }
  .posts-layout {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 1.6rem;
    align-items: start;
  }

  /* 左侧栏：作者名片 + 图标导航两张毛玻璃卡，滚动时整体粘性固定。
     sticky 必须作用于 aside 本身——其包含块是整行高的 grid area；
     若作用于内部卡片，align-items:start 会使 aside 只有内容高度，
     sticky 没有滑动空间而失效 */
  .author {
    position: sticky;
    top: 4.6rem;
    display: grid;
    gap: 1.6rem;
  }
  .author-card {
    background: var(--card);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.6rem 1.3rem;
    text-align: center;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
  }
  .author-avatar {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    border: 1px solid var(--border);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
  }
  .author-name {
    margin: 0.9rem 0 0.3rem;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text);
    font-family: var(--font-serif);
  }
  .author-bio {
    margin: 0;
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 1.6;
  }
  .author-motto {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    color: var(--text);
    font-family: var(--font-serif);
    opacity: 0.9;
  }
  /* 统计行：文章 / 标签 / 运行天数 */
  .author-stats {
    display: flex;
    justify-content: center;
    gap: 1.4rem;
    margin-top: 1.1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
  .author-stat .num {
    display: block;
    font-family: var(--font-mono);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--accent);
    line-height: 1.2;
  }
  .author-stat .label {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.75rem;
    color: var(--muted);
  }
  /* Links 社交圆钮（样式同首屏 social） */
  .author-links {
    display: flex;
    justify-content: center;
    gap: 0.7rem;
    margin-top: 1rem;
  }
  .author-links a {
    display: inline-flex;
    padding: 0.4rem;
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--muted);
    transition: color 0.2s, border-color 0.2s;
  }
  .author-links a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* 图标导航卡：当前页 accent 高亮 + 左侧竖线 */
  .side-nav {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    background: var(--card);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 0.6rem;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
  }
  .side-nav a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.7rem;
    font-size: 0.88rem;
    color: var(--muted);
    text-decoration: none;
    border-left: 3px solid transparent;
    border-radius: 0 8px 8px 0;
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease;
  }
  .side-nav a svg {
    flex-shrink: 0;
  }
  .side-nav a:hover {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 6%, transparent);
  }
  .side-nav a.active {
    color: var(--accent);
    border-left-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  @media (max-width: 1023px) {
    /* 窄屏退回单栏：名片变为横向条，导航卡隐藏（顶部导航已有同等入口） */
    .posts-layout {
      grid-template-columns: 1fr;
    }
    .author {
      position: static;
    }
    .side-nav {
      display: none;
    }
    .author-card {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.4rem 1rem;
      text-align: left;
      padding: 1rem 1.3rem;
    }
    .author-avatar {
      width: 48px;
      height: 48px;
      flex-shrink: 0;
    }
    /* 文字组占满头像右侧 */
    .author-text {
      flex: 1;
      min-width: 0;
    }
    .author-name {
      margin: 0 0 0.2rem;
    }
    .author-motto,
    .author-links {
      display: none;
    }
    .author-stats {
      flex-basis: 100%;
      margin-top: 0.6rem;
      padding-top: 0.7rem;
      gap: 1.6rem;
    }
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
    /* 卡片之间的空隙直接露出背景照片 */
    display: grid;
    gap: 1.6rem;
  }

  /* 每篇文章一张独立毛玻璃卡片，悬浮在照片上 */
  .post-card {
    display: block;
    background: var(--card);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.6rem 1.7rem;
    text-decoration: none;
    color: var(--text);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
    transition:
      transform 0.2s,
      box-shadow 0.2s,
      border-color 0.2s;
  }
  .post-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.15);
    border-color: color-mix(in srgb, var(--accent) 55%, var(--border));
  }
  .post-card:hover h2 {
    color: var(--accent);
  }
  .post-card h2 {
    transition: color 0.2s;
  }

  .post-meta {
    color: var(--muted);
    font-size: 0.85rem;
    font-family: var(--font-mono);
  }
  .post-meta .dot {
    margin: 0 0.4rem;
  }
  .post-card h2 {
    margin: 0.4rem 0 0.5rem;
    font-size: 1.25rem;
  }
  .post-card p {
    margin: 0 0 0.8rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .post-footer {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .tag {
    font-size: 0.75rem;
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--muted);
    background: color-mix(in srgb, var(--accent) 6%, transparent);
  }
  .read-more {
    margin-left: auto;
    color: var(--accent);
    font-size: 0.9rem;
  }

  /* 进场动画：JS 可用时先隐藏，进入视口后上浮淡入、逐条错开 */
  :global(html.js) .reveal {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 0.7s ease,
      transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);
    will-change: opacity, transform;
  }
  :global(html.js) .reveal.visible {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
