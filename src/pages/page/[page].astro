---
import Layout from "../../layouts/Layout.astro";
import PostFeed from "../../components/PostFeed.astro";
import { getCollection } from "astro:content";
import { siteConfig } from "../../config";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );
  const pageSize = siteConfig.pageSize;
  const totalPages = Math.max(1, Math.ceil(posts.length / pageSize));

  const paths = [];
  for (let p = 2; p <= totalPages; p++) {
    const start = (p - 1) * pageSize;
    paths.push({
      params: { page: String(p) },
      props: {
        posts: posts.slice(start, start + pageSize),
        currentPage: p,
        totalPages,
      },
    });
  }
  return paths;
}

const { posts, currentPage, totalPages } = Astro.props;
const prevUrl = currentPage === 2 ? "/#posts" : `/page/${currentPage - 1}/`;
const nextUrl = currentPage < totalPages ? `/page/${currentPage + 1}/` : undefined;
---

<Layout
  title={`第 ${currentPage} 页`}
  description={`${siteConfig.siteName} 文章列表（第 ${currentPage} 页 / 共 ${totalPages} 页）`}
  wide
  panel={false}
>
  <PostFeed
    posts={posts}
    currentPage={currentPage}
    totalPages={totalPages}
    prevUrl={prevUrl}
    nextUrl={nextUrl}
  />
</Layout>
